# CarScout backend environment — copy to `.env` and fill in.
# `.env` is git-ignored; never commit real keys.

# LLM provider (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Added in later phases (leave blank for now) ---
# Supabase (Phase 2/3)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Inventory + enrichment data sources (Phase 3/4)
# AUTODEV_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Comma-separated allowed CORS origins (Phase 1). Defaults to "*" if unset.
# ALLOWED_ORIGINS=http://localhost:5173
