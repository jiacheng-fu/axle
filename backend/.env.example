# CarScout backend environment — copy to `.env` and fill in.
# `.env` is git-ignored; never commit real keys.

# LLM provider (OpenRouter, OpenAI-compatible) — powers preference extraction,
# the conversational replies, and the comparison insights.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Data source for dealers + inventory:
#   autodev (default) — Auto.dev Vehicle Listings API. Results are cached to disk
#                       (backend/.cache/autodev/), so re-running the SAME zip makes
#                       ZERO API calls — safe to re-record demos without burning quota.
#   seed              — bundled demo inventory only, no network / no API calls.
CARSCOUT_DATA_SOURCE=autodev

# Auto.dev — free Starter tier: 1k calls/mo, nationwide. Key: https://auto.dev/dashboard/api-keys
AUTODEV_API_KEY=
# AUTODEV_LIMIT=100             # results per API call (capped by plan)
# AUTODEV_PAGES=5              # pages fetched per zip (more pages = more dealers)
# AUTODEV_CACHE_TTL=2592000    # disk cache lifetime in seconds (default 30 days)

# --- Added in later phases (leave blank for now) ---
# Supabase (Phase 2/3)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# GOOGLE_PLACES_API_KEY=   (Phase 4 — dealer discovery fallback)

# Comma-separated allowed CORS origins (Phase 1). Defaults to "*" if unset.
# ALLOWED_ORIGINS=http://localhost:5173
