# Axle frontend environment — copy to `.env` and adjust.

# Base URL of the backend API.
# Local dev: http://localhost:8000
# On Vercel (same-origin deploy): /api
VITE_API_BASE=http://localhost:8000

# Supabase (accounts + saved cars). From your project's Settings -> API.
# The anon key is safe to expose client-side; Row-Level Security protects data.
# If unset, the app still runs but sign-in is disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
